{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "AOS": "readonly",
    "GLightbox": "readonly",
    "Swiper": "readonly",
    "imagesLoaded": "readonly",
    "Isotope": "readonly",
    "initSwiperWithCustomPagination": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "warn"
  }
} 